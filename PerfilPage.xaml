<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E230138.PerfilPage"
             Title="Mi Perfil"
             BackgroundColor="#FCE7F3">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Mi perfil"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#831843"
                       HorizontalOptions="Center"/>

                <Label Text="Administra tu información personal"
                       FontSize="13"
                       TextColor="#9D6480"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Tarjeta de usuario -->
            <Border BackgroundColor="White"
                    Stroke="#FBCFE8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="22">

                <VerticalStackLayout Spacing="15">

                    <!-- Avatar -->
                    <Border WidthRequest="95"
                            HeightRequest="95"
                            Stroke="#FBCFE8"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 48"
                            BackgroundColor="#DB2777"
                            HorizontalOptions="Center">

                        <Label Text=".NET"
                               FontSize="21"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Nombre -->
                    <Label x:Name="NombreLabel"
                           Text="Cargando..."
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#831843"
                           HorizontalOptions="Center"/>

                    <Label Text="Usuario de la aplicación"
                           FontSize="12"
                           TextColor="#BE185D"
                           HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1"
                             Color="#FCE7F3"/>

                    <!-- Disponibilidad -->
                    <Border BackgroundColor="#FFF1F7"
                            Stroke="#FBCFE8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14">

                        <HorizontalStackLayout Spacing="10"
                                               VerticalOptions="Center">

                            <VerticalStackLayout Spacing="3"
                                                 HorizontalOptions="StartAndExpand">

                                <Label Text="Disponibilidad laboral"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#831843"/>

                                <Label Text="Disponible para trabajar"
                                       FontSize="12"
                                       TextColor="#9D6480"/>

                            </VerticalStackLayout>

                            <Switch x:Name="DisponibleSwitch"
                                    OnColor="#DB2777"
                                    ThumbColor="White"
                                    VerticalOptions="Center"/>

                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Experiencia -->
            <Border BackgroundColor="White"
                    Stroke="#FBCFE8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">

                        <Label Text="Experiencia profesional"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#831843"/>

                        <Label Text="Selecciona tus años de experiencia"
                               FontSize="12"
                               TextColor="#9D6480"/>

                    </VerticalStackLayout>

                    <!-- Slider -->
                    <Slider x:Name="ExperienciaSlider"
                            Minimum="0"
                            Maximum="15"
                            MinimumTrackColor="#DB2777"
                            MaximumTrackColor="#FBCFE8"
                            ThumbColor="#BE185D"
                            ValueChanged="OnSliderChanged"/>

                    <!-- Nivel de experiencia -->
                    <Border x:Name="NivelBorder"
                            BackgroundColor="#FCE7F3"
                            Stroke="#FBCFE8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="18">

                        <VerticalStackLayout Spacing="7">

                            <Label Text="TU EXPERIENCIA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#BE185D"
                                   HorizontalOptions="Center"/>

                            <Label x:Name="AniosLabel"
                                   Text="0 años de experiencia"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#831843"
                                   HorizontalOptions="Center"/>

                            <Label x:Name="NivelLabel"
                                   Text="Nivel Inicial"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#DB2777"
                                   HorizontalOptions="Center"/>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Cerrar sesión -->
            <Button Text="CERRAR SESIÓN"
                    BackgroundColor="#DB2777"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="13"
                    HeightRequest="52"
                    Clicked="OnCerrarSesionClicked"/>

            <Label Text="♡  Gracias por formar parte de nuestra aplicación  ♡"
                   FontSize="11"
                   TextColor="#D48BAE"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
