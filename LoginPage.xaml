<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PM2E230138.LoginPage"
             Title="Iniciar sesión"
             BackgroundColor="#FCE7F3">

    <ScrollView>
        <Grid Padding="24"
              VerticalOptions="Center">

            <!-- Tarjeta principal -->
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#FBCFE8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="26">

                <VerticalStackLayout Spacing="18">

                    <!-- Encabezado -->
                    <VerticalStackLayout Spacing="9"
                                         HorizontalOptions="Center">

                        <Border BackgroundColor="#FCE7F3"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="16"
                                WidthRequest="76"
                                HeightRequest="76">

                            <Label Text="♥"
                                   FontSize="34"
                                   TextColor="#DB2777"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="¡Bienvenido!"
                               FontSize="29"
                               FontAttributes="Bold"
                               TextColor="#831843"
                               HorizontalOptions="Center"/>

                        <Label Text="Ingresa tus datos para continuar"
                               FontSize="13"
                               TextColor="#9D6480"
                               HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="#FCE7F3"/>

                    <!-- Correo electrónico -->
                    <VerticalStackLayout Spacing="7">

                        <Label Text="Correo electrónico"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#831843"/>

                        <Border BackgroundColor="#FFF1F7"
                                Stroke="#FBCFE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">

                            <Entry x:Name="CorreoEntry"
                                   Placeholder="ejemplo@correo.com"
                                   Keyboard="Email"
                                   TextColor="#831843"
                                   PlaceholderColor="#D4A0B8"
                                   BackgroundColor="Transparent"/>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Contraseña -->
                    <VerticalStackLayout Spacing="7">

                        <Label Text="Contraseña"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#831843"/>

                        <Border BackgroundColor="#FFF1F7"
                                Stroke="#FBCFE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">

                            <Entry x:Name="ClaveEntry"
                                   Placeholder="Ingresa tu contraseña"
                                   IsPassword="True"
                                   TextColor="#831843"
                                   PlaceholderColor="#D4A0B8"
                                   BackgroundColor="Transparent"/>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Mostrar contraseña -->
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">

                        <CheckBox x:Name="MostrarClaveCheck"
                                  Color="#DB2777"
                                  VerticalOptions="Center"
                                  CheckedChanged="OnMostrarClaveChanged"/>

                        <Label Text="Mostrar contraseña"
                               FontSize="13"
                               TextColor="#9D6480"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <!-- Intentos fallidos -->
                    <Border BackgroundColor="#FFF7FA"
                            Stroke="#FBCFE8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">

                        <HorizontalStackLayout Spacing="9">

                            <Label Text="●"
                                   TextColor="#EC4899"
                                   VerticalOptions="Center"/>

                            <Label x:Name="IntentosLabel"
                                   Text="Intentos fallidos: 0 de 3"
                                   FontSize="12"
                                   TextColor="#9D6480"
                                   VerticalOptions="Center"/>

                        </HorizontalStackLayout>
                    </Border>

                    <!-- Botón de inicio -->
                    <Button x:Name="LoginBtn"
                            Text="INICIAR SESIÓN"
                            BackgroundColor="#DB2777"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="13"
                            HeightRequest="52"
                            Clicked="OnLoginClicked"/>

                    <!-- Indicador de carga -->
                    <ActivityIndicator x:Name="Cargando"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#DB2777"
                                       HorizontalOptions="Center"/>

                    <!-- Pie de tarjeta -->
                    <Label Text="♡  Acceso seguro a tu cuenta  ♡"
                           FontSize="11"
                           TextColor="#D48BAE"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
